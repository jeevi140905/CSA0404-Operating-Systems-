#include <stdio.h>
#include <string.h>

int main() {
    char files[10][20];
    int n = 0, choice;
    char name[20];

    do {
        printf("\n1.Create File\n2.Display Files\n3.Exit\n");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Enter file name: ");
                scanf("%s", name);
                strcpy(files[n], name);
                n++;
                break;

            case 2:
                printf("Files in directory:\n");
                for (int i = 0; i < n; i++)
                    printf("%s\n", files[i]);
                break;
        }
    } while (choice != 3);

    return 0;
}
