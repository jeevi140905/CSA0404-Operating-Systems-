#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

sem_t mutex, writeblock;
int data = 0, readcount = 0;

void *reader(void *arg) {
    sem_wait(&mutex);
    readcount++;
    if (readcount == 1)
        sem_wait(&writeblock);
    sem_post(&mutex);

    printf("Reader %d reads data = %d\n", *(int *)arg, data);
    sleep(1);

    sem_wait(&mutex);
    readcount--;
    if (readcount == 0)
        sem_post(&writeblock);
    sem_post(&mutex);
}

void *writer(void *arg) {
    sem_wait(&writeblock);
    data++;
    printf("Writer writes data = %d\n", data);
    sem_post(&writeblock);
}

int main() {
    pthread_t r1, r2, w;
    int a = 1, b = 2;

    sem_init(&mutex, 0, 1);
    sem_init(&writeblock, 0, 1);

    pthread_create(&r1, NULL, reader, &a);
    pthread_create(&r2, NULL, reader, &b);
    pthread_create(&w, NULL, writer, NULL);

    pthread_join(r1, NULL);
    pthread_join(r2, NULL);
    pthread_join(w, NULL);

    return 0;
}
