#include <pthread.h>
#include <stdio.h>

void* fun(void *arg) {
    printf("Thread running\n");
    pthread_exit(NULL);
}

int main() {
    pthread_t t;
    pthread_create(&t,NULL,fun,NULL);
    pthread_join(t,NULL);
    printf("Thread joined\n");
    return 0;
}
