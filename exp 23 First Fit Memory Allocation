#include <stdio.h>

int main() {
    int m,p,i,j;
    int mem[10], proc[10], alloc[10];

    scanf("%d",&m);
    for(i=0;i<m;i++) scanf("%d",&mem[i]);
    scanf("%d",&p);
    for(i=0;i<p;i++) scanf("%d",&proc[i]);

    for(i=0;i<p;i++) alloc[i]=-1;

    for(i=0;i<p;i++) {
        for(j=0;j<m;j++) {
            if(mem[j]>=proc[i]) {
                alloc[i]=j;
                mem[j]-=proc[i];
                break;
            }
        }
    }

    for(i=0;i<p;i++)
        printf("P%d -> B%d\n",i+1,alloc[i]+1);
    return 0;
}
