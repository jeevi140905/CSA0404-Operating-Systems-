#include <stdio.h>

int main() {
    int frames=3, pages[10]={1,3,0,3,5,6}, i, j, f[3]={-1,-1,-1}, k=0;
    for(i=0;i<6;i++) {
        f[k]=pages[i];
        k=(k+1)%frames;
        for(j=0;j<frames;j++) printf("%d ",f[j]);
        printf("\n");
    }
    return 0;
}
