#include <stdio.h>
#include <dirent.h>
#include <sys/stat.h>

int main() {
    DIR *d;
    struct dirent *dir;
    struct stat s;

    stat("test.txt",&s);
    printf("File size: %ld\n",s.st_size);

    d = opendir(".");
    while((dir = readdir(d)) != NULL)
        printf("%s\n",dir->d_name);
    closedir(d);
    return 0;
}
